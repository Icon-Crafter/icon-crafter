# iconcrafter-server environment template.
#
# Copy to `.env` (or export the variables in your shell) and adjust. Every
# value below is a safe placeholder: there are no real credentials here.
# The server never reads a `.env` file by itself — use your shell, a process
# manager, or `docker compose --env-file` to load these values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Must use the `postgres://` or `postgresql://`
# scheme. The server runs the migrations in `migrations/` on startup.
DATABASE_URL=postgres://iconcrafter:iconcrafter@127.0.0.1:5432/iconcrafter

# ---------------------------------------------------------------------------
# HTTP listener and public URL
# ---------------------------------------------------------------------------

# Address the Axum server binds. Default: 127.0.0.1:8080.
LISTEN_ADDR=127.0.0.1:8080

# Absolute base URL clients use to reach this server. Used for share/publish
# links and for the default COOKIE_SECURE decision. No trailing slash.
# Default: http://127.0.0.1:8080.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Comma-separated browser origins allowed by CORS, e.g.
# `http://localhost:1420,https://app.example.com`. Empty disables CORS
# entirely (non-browser clients are unaffected).
CORS_ORIGINS=

# Optional directory served read-only at `/static` (useful for local front-end
# builds). Leave empty to disable.
SERVE_STATIC_DIR=

# ---------------------------------------------------------------------------
# Sessions, cookies and CSRF
# ---------------------------------------------------------------------------

# Name of the HttpOnly session cookie. Default: ic_session.
SESSION_COOKIE_NAME=ic_session

# Session lifetime in hours (1..=8760). Default: 720 (30 days).
SESSION_TTL_HOURS=720

# Mark cookies `Secure`. Defaults to true when PUBLIC_BASE_URL starts with
# https://, false otherwise. Set explicitly when terminating TLS upstream.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# In-process token-bucket budget per client IP and route, per minute.
# Default: 60. Applies to /api/auth/* and /api/shares/{token}/access.
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Database pool
# ---------------------------------------------------------------------------

# Maximum PostgreSQL connections held by the pool (1..=100). Default: 10.
DATABASE_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# `local` writes to STORAGE_LOCAL_DIR. `s3` requires a binary built with the
# `s3` cargo feature and the S3_* settings below.
STORAGE_KIND=local

# Root directory for `STORAGE_KIND=local`. Content-addressed keys are resolved
# beneath this directory; path traversal is rejected. Default: ./data/storage.
STORAGE_LOCAL_DIR=./data/storage

# S3 settings (only used when STORAGE_KIND=s3).
S3_BUCKET=iconcrafter
S3_REGION=us-east-1

# Optional custom endpoint for S3-compatible services (MinIO, R2, ...).
# When set, path-style addressing defaults to true.
S3_ENDPOINT=

# Optional static credentials. Leave both empty to use the AWS credential
# chain (instance profile, environment, SSO). Setting only one is an error.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Force path-style bucket addressing (`endpoint/bucket/key`). Defaults to true
# when S3_ENDPOINT is set, false otherwise.
S3_FORCE_PATH_STYLE=

# Key prefix inside the bucket. Default: iconcrafter/ (trailing slash added).
S3_PREFIX=iconcrafter/

# ---------------------------------------------------------------------------
# Uploads and logs
# ---------------------------------------------------------------------------

# Hard limit for asset uploads in bytes (1024..=536870912).
# Default: 26214400 (25 MiB). JSON request bodies are separately capped at
# 8 MiB by the server.
MAX_UPLOAD_BYTES=26214400

# `text` (default) or `json` for newline-delimited JSON logs.
LOG_FORMAT=text

# Tracing filter; `info,tower_http=warn,sqlx=warn` is the default.
RUST_LOG=info,tower_http=warn,sqlx=warn

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Only needed for the `#[ignore]`d database integration tests:
#   cargo test -p iconcrafter-server --offline -- --ignored
# Point this at a disposable database; the tests create and drop their schemas.
TEST_DATABASE_URL=postgres://iconcrafter:iconcrafter@127.0.0.1:5432/iconcrafter_test
